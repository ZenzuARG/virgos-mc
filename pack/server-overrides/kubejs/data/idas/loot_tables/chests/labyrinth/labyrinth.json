          "functions": [
            {
              "function": "set_nbt",
              "tag": "{\r\n          pages:[\r\n              \"[\r\n                \\\"\\\",\r\n                {\\\"text\\\":\\\"§lThe End\n\\\"},\r\n                {\\\"text\\\":\\\"~~~~~~~~~\n\\\"},\r\n                {\\\"text\\\":\\\"I've had to hide from the monsters that lurk in this thing. I can still hear the groaning outside. \\\"},\r\n                {\\\"text\\\":\\\"I think if I don't leave.. this will be the end of me.\\\"}\r\n              ]\",\r\n              \"[\r\n                {\\\"text\\\":\\\"If you're reading this, keep going! Break the curse! \\\"},\r\n                {\\\"text\\\":\\\"Find the treasure!\\\"}\r\n              ]\",\r\n              \"[\r\n                {\\\"text\\\":\\\"-Salazar, Dungeon Buster Extraordinaire.\\\"}\r\n              ]\"\r\n            ],\r\n            title:Journal,\r\n            author:Salazar,\r\n            display:{Lore:[\"Found in the mighty Labyrinth\"]}\r\n            }"
