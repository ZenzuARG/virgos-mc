            {
              "function": "set_nbt",
              "tag": "{\r\n          pages:[\r\n              \"[\r\n                \\\"\\\",\r\n                {\\\"text\\\":\\\"§kREDACTED\\\"},\r\n                {\\\"text\\\":\\\"§l’s Journal\nDay 152\n\n\\\"},\r\n                {\\\"text\\\":\\\"I have always wondered what the ancient letters in the ceiling mean. \\\"},\r\n                {\\\"text\\\":\\\"Today I learned they are in the Language of Enchantment.\\\"}\r\n              ]\",\r\n              \"[\r\n                {\\\"text\\\":\\\"Maybe there is a translator book that could help me decipher them...\\\"}\r\n              ]\"\r\n            ],\r\n            title:Journal,\r\n            author:Unknown,\r\n            display:{Lore:[\"Found in the ancient Stronghold\"]}\r\n            }"
