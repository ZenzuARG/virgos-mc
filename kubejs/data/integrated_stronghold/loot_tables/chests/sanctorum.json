        {
          "type": "minecraft:item",
          "weight": 1,
          "name": "minecraft:written_book",
          "functions": [
            {
              "function": "set_nbt",
              "tag": "{\r\n          pages:[\r\n              \"[\r\n                \\\"\\\",\r\n                {\\\"text\\\":\\\"§lThe Scripture\n\n\\\"},\r\n                {\\\"text\\\":\\\"We have one goal: to\n\\\"},\r\n                {\\\"text\\\":\\\"breath beauty and life\n\\\"},\r\n                {\\\"text\\\":\\\"into this world\n\\\"},\r\n                {\\\"text\\\":\\\"through building. Our\n\\\"},\r\n                {\\\"text\\\":\\\"current form limits\n\\\"},\r\n                {\\\"text\\\":\\\"our ability to fulfill\n\\\"},\r\n                {\\\"text\\\":\\\"our imaginations. To\n\\\"},\r\n                {\\\"text\\\":\\\"realize our full\n\\\"},\r\n                {\\\"text\\\":\\\"potential, we must\n\\\"},\r\n                {\\\"text\\\":\\\"achieve The End form.\\\"}\r\n              ]\",\r\n              \"[\r\n                {\\\"text\\\":\\\"§oThe End \\\"},\r\n                {\\\"text\\\":\\\"form is the next step in our evolution.\n\n\\\"},\r\n                {\\\"text\\\":\\\"It is our full potential realized. \\\"},\r\n                {\\\"text\\\":\\\"The bounds of our mortal bodies would be lifted, we would be free to build. \\\"},\r\n                {\\\"text\\\":\\\"§oThe End \\\"},\r\n                {\\\"text\\\":\\\"will be granted to us by the One Above All. \\\"},\r\n                {\\\"text\\\":\\\"She need us, her disciples, to fullfill her goals.\\\"}\r\n              ]\",\r\n              \"[\r\n                {\\\"text\\\":\\\"With our help,\n\n\\\"},\r\n                {\\\"text\\\":\\\"§oThe One Above All \\\"},\r\n                {\\\"text\\\":\\\"will snuff out the fires of the forest...\n\n\\\"},\r\n                {\\\"text\\\":\\\"She will cease all famine...\n\n\\\"},\r\n                {\\\"text\\\":\\\"She will save the sick and needy...\\\"}\r\n              ]\",\r\n              \"[\r\n                {\\\"text\\\":\\\"She will stop the\n\\\"},\r\n                {\\\"text\\\":\\\"§kundead\\\"},\r\n                {\\\"text\\\":\\\"from rising...\n\n\\\"},\r\n                {\\\"text\\\":\\\"She will elevate us to new levels\n\n\\\"},\r\n                {\\\"text\\\":\\\"Together, we will transform this world into a sanctuary for all, \\\"},\r\n                {\\\"text\\\":\\\"free of violence, suffering, and \\\"},\r\n                {\\\"text\\\":\\\"§kREDACTED\\\"}\r\n              ]\",\r\n              \"[\r\n                {\\\"text\\\":\\\"§nWe know this.\n\n\\\"},\r\n                {\\\"text\\\":\\\"§oWe have already seen it in the rocks from the sky.\\\"}\r\n              ]\",\r\n              \"[\r\n                {\\\"text\\\":\\\"§oShe waits for us.\n\n\\\"},\r\n                {\\\"text\\\":\\\"§oWith her thunderous roar she waits for us.\n\n\\\"},\r\n                {\\\"text\\\":\\\"§oWith her magical breath she waits for us.\n\n\\\"},\r\n                {\\\"text\\\":\\\"§oFlying high in the sky she waits for us.\\\"}\r\n              ]\",\r\n              \"[\r\n                {\\\"text\\\":\\\"And we will find her.\\\"}\r\n              ]\"\r\n            ],\r\n            title:Scripture,\r\n            author:Priest,\r\n            display:{Lore:[\"Found in the ancient Stronghold\"]}\r\n            }"
            },
            {
              "function": "minecraft:set_name",
              "name": "Scripture of the Dragon",
              "add": false
            }
          ]
        },
        {
          "type": "minecraft:item",
          "weight": 1,
          "name": "minecraft:written_book",
          "functions": [
            {
              "function": "set_nbt",
              "tag": "{\r\n          pages:[\r\n              \"[\r\n                \\\"\\\",\r\n                {\\\"text\\\":\\\"§kREDACTED\\\"},\r\n                {\\\"text\\\":\\\"§l’s Journal\nDay 25\n\n\\\"},\r\n                {\\\"text\\\":\\\"It has been around 2 weeks since the Asteroid fell into this mighty stronghold and we were blessed with a vision of the future. \\\"},\r\n                {\\\"text\\\":\\\"A better future.\\\"}\r\n              ]\",\r\n              \"[\r\n                {\\\"text\\\":\\\"In honor of the One Above All, who will bring us this better future, we are erecting a statue. \\\"},\r\n                {\\\"text\\\":\\\"This will serve as a reminder of our main goal, achieving The End.\\\"}\r\n              ]\"\r\n            ],\r\n            title:Journal,\r\n            author:Unknown,\r\n            display:{Lore:[\"Found in the ancient Stronghold\"]}\r\n            }"
            },
            {
              "function": "minecraft:set_name",
              "name": "Mysterious Journal #13",
              "add": false
            }
          ]
        },
        {
          "type": "minecraft:item",
          "weight": 1,
          "name": "minecraft:written_book",
          "functions": [
            {
              "function": "set_nbt",
              "tag": "{\r\n          pages:[\r\n              \"[\r\n                \\\"\\\",\r\n                {\\\"text\\\":\\\"§kREDACTED\\\"},\r\n                {\\\"text\\\":\\\"§l’s Journal\nDay 79\n\n\\\"},\r\n                {\\\"text\\\":\\\"As tribute to the great One Above All, I donated my finest tools I forged in the armory. \\\"},\r\n                {\\\"text\\\":\\\"I hope the researchers can use these tools to help us fulfill our purpose.\\\"}\r\n              ]\"\r\n            ],\r\n            title:Journal,\r\n            author:Unknown,\r\n            display:{Lore:[\"Found in the ancient Stronghold\"]}\r\n            }"
            },
            {
              "function": "minecraft:set_name",
