              "tag": "{\r\n          pages:[\r\n              \"[\r\n                \\\"\\\",\r\n                {\\\"text\\\":\\\"     a    <-->   ᔑ\n\\\"},\r\n                {\\\"text\\\":\\\"     b    <-->   ʖ\n\\\"},\r\n                {\\\"text\\\":\\\"     c    <-->   ᓵ\n\\\"},\r\n                {\\\"text\\\":\\\"     d    <-->   ↸\n\\\"},\r\n                {\\\"text\\\":\\\"     e    <-->   ᒷ\n\\\"},\r\n                {\\\"text\\\":\\\"     f    <-->   ⎓\n\\\"},\r\n                {\\\"text\\\":\\\"     g    <-->   ⊣\n\\\"},\r\n                {\\\"text\\\":\\\"     h    <-->   ⍑\n\\\"},\r\n                {\\\"text\\\":\\\"      i    <-->   ╎\n\\\"},\r\n                {\\\"text\\\":\\\"     j    <-->   ⋮\n\\\"},\r\n                {\\\"text\\\":\\\"     k    <-->   ꖌ\n\\\"},\r\n                {\\\"text\\\":\\\"      l    <-->   ꖎ\n\\\"},\r\n                {\\\"text\\\":\\\"     m    <-->   ᒲ\n\\\"},\r\n                {\\\"text\\\":\\\"     n    <-->   リ\\\"}\r\n              ]\",\r\n              \"[\r\n                {\\\"text\\\":\\\"     o    <-->   𝙹\n\\\"},\r\n                {\\\"text\\\":\\\"     p    <-->   !¡\n\\\"},\r\n                {\\\"text\\\":\\\"     q    <-->   ᑑ\n\\\"},\r\n                {\\\"text\\\":\\\"     r    <-->   ∷\n\\\"},\r\n                {\\\"text\\\":\\\"     s    <-->   ᓭ\n\\\"},\r\n                {\\\"text\\\":\\\"     t    <-->   ℸ\n\\\"},\r\n                {\\\"text\\\":\\\"     u    <-->   ⚍\n\\\"},\r\n                {\\\"text\\\":\\\"     v    <-->   ⍊\n\\\"},\r\n                {\\\"text\\\":\\\"     w    <-->   ∴\n\\\"},\r\n                {\\\"text\\\":\\\"     x    <-->   ̇/\n\\\"},\r\n                {\\\"text\\\":\\\"     y    <-->   ||\n\\\"},\r\n                {\\\"text\\\":\\\"     z    <-->   ⨅\\\"}\r\n              ]\"\r\n            ],\r\n            title:Redstone,\r\n            author:Unknown,\r\n            display:{Lore:[\"Found in the ancient Stronghold\"]}\r\n            }"
            },
